{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenLess",
  "version": "2.0.2-Beta.3+build.20261026-c9f49c60",
  "identifier": "com.openless.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "OpenLess",
        "width": 1300,
        "height": 835,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "decorations": true,
        "transparent": true,
        "shadow": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 16, "y": 26 },
        "visible": false,
        "acceptFirstMouse": true
      },
      {
        "label": "capsule",
        "url": "index.html?window=capsule",
        "title": "OpenLess Capsule",
        "width": 460,
        "height": 180,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visible": false,
        "center": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "font-src": "'self' https://fonts.gstatic.com",
        "img-src": "'self' asset: http://asset.localhost blob: data: https://github.com https://avatars.githubusercontent.com",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420",
        "media-src": "'self' data: asset: http://asset.localhost blob:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../crates/micyou-dsp/LICENSE": "licenses/micyou/LICENSE",
      "../crates/micyou-dsp/LICENSE-RNNoise.txt": "licenses/micyou/LICENSE-RNNoise.txt",
      "../crates/micyou-dsp/LICENSE-PureVox.txt": "licenses/micyou/LICENSE-PureVox.txt",
      "../crates/micyou-dsp/LICENSE-AEC7.txt": "licenses/micyou/LICENSE-AEC7.txt",
      "../crates/micyou-dsp/UPSTREAM.md": "licenses/micyou/UPSTREAM.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist"
    },
    "android": {
      "minSdkVersion": 26
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "nsis/openless-ime-hooks.nsh"
      },
      "wix": {
        "fragmentPaths": [
          "wix/openless-ime.wxs"
        ],
        "componentRefs": [
          "OpenLessImeDllX64Component",
          "OpenLessImeDllX86Component"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFERUFBODAzNTY0QzMyM0YKUldRL01reFdBNmpxSGE1K0JadlpONXNWTzhJcGZCRGxjUVdIWExNNFJpeUNsSGZwazdlQThhemkK",
      "endpoints": [
        "https://dl.aeoform.com/updates/stable/latest-{{target}}-{{arch}}.json"
      ]
    }
  }
}
