{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.openless.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run check:macos-metal-toolchain && npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenLess",
        "width": 1240,
        "height": 800,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true,
        "decorations": true,
        "visible": true
      }
    ]
  }
}
