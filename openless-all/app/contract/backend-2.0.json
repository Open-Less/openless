{
  "contractVersion": "2.0.0",
  "dictationReferences": {
    "hosts": ["macos"],
    "preferences": { "dictationReferencesEnabled": false, "dictationReferenceKey": "S" },
    "capsule": { "referenceCount": 0, "referenceNotice": [null, "screenPermission", "tooLarge", "captureFailed"] },
    "commands": {
      "get_dictation_references_status": { "scope": "desktop", "args": {}, "result": { "supported": "boolean", "screenCapture": ["granted", "denied", "unknown"] } },
      "open_dictation_references_permission_settings": { "scope": "desktop", "args": {}, "result": "void" }
    },
    "retentionDays": 7,
    "delivery": "named local references; no native attachments; local access is not guaranteed"
  },
  "testingFeatures": {
    "preferenceField": "testingFeaturesEnabled",
    "default": false,
    "scope": "device_local",
    "features": ["lessComputer", "claudeConsole"],
    "disabledBehavior": [
      "hide_entries_and_windows",
      "unregister_less_computer_hotkeys",
      "reject_runtime_admission",
      "cancel_active_tasks",
      "preserve_feature_settings"
    ],
    "disabledErrorCode": "permission_denied",
    "cloudSync": "excluded"
  },
  "selectionOriginalProtection": {
    "input": "complete explicit selection, including boundary whitespace; no application character cap",
    "history": {
      "store": "history.json",
      "identity": "existing sessionId",
      "original": "rawTranscript",
      "result": "finalText",
      "order": ["persist_original", "protect_original_clipboard", "model_request", "validate_original_target", "replace_once"],
      "provisionalStatus": "selectionProcessing",
      "failure": "retain_original_and_any_complete_result"
    },
    "hostPort": "SelectionRuntimeAdapter.protect_original(sessionId, completeOriginal) -> Result<Option<opaque clipboard revision>>",
    "voiceApplyTicket": "optional originalClipboardRevision binds the original clipboard transaction to the existing sessionId",
    "recoveryNotice": "only confirmed Inserted and frozen original Unicode scalar count > 4000; never trim or count bytes/UTF-16 units",
    "historyCopy": "existing detail copy follows raw/polished view; no list checkboxes or bulk copy",
    "successfulWrite": "do not copy result; restore protected original unless a later user copy owns clipboard",
    "definiteNoWrite": "copy complete result only while original clipboard transaction still owns clipboard",
    "uncertainWrite": "PasteSent or OutcomeUnknown; never retry or copy as if definitely not inserted",
    "previewOnlyHosts": "supplied-text iOS preview never writes an external selection or automatically accesses clipboard"
  },
  "appStyleRouting": {
    "hosts": ["macos", "windows"],
    "categories": "catalog.categories[].id",
    "catalogApi": {
      "baseUrl": "MarketplaceConfig.base_url",
      "path": "/v1/app-catalog",
      "cacheFile": "input-app-catalog-cache.json",
      "refresh": "background_at_startup_and_on_page_request",
