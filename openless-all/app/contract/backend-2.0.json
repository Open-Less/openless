        "args": {
          "assignment": [
            { "target": "category", "category": "coding", "stylePackId": "builtin.structured" },
            { "target": "app", "appId": "macos:com.microsoft.VSCode", "stylePackId": null },
            { "target": "membership", "memberId": "catalog:vscode", "category": "coding" }
          ]
        },
        "result": "AppStyleRouting"
      },
      "clear_input_app_history": { "result": "AppStyleRouting" },
      "get_input_app_icons": { "result": "map<appId, PNG data URL>" }
    },
    "precedence": [
      "explicit_session_pack",
      "specific_app",
      "app_category",
      "current_pack",
      "enabled_default"
    ],
    "maxPacksPerTarget": 1,
    "sharedPacksAllowed": true,
    "maxCategoriesPerMember": 1,
    "membershipOverrides": "device_local_replace_or_explicitly_unclassify",
    "applicationListInvalidatedBy": "history_changed",
    "unavailableAssignment": "keep_and_skip"
  },
  "recordingTranslation": {
    "preference": {
      "field": "translationShiftTapCount",
      "type": "optional nonzero uint8",
      "default": 1,
      "range": [1, 255],
      "uiChoices": [1, 2, 3],
      "absent": "untouched; omit when serialized",
      "explicitDefault": "persist and sync 1",
      "sync": "v1 preferences Portable"
    },
    "nativeShiftGesture": {
      "hosts": ["macos", "windows"],
      "binding": "built-in standalone Shift translation shortcut only",
      "tapMaxMs": 350,
      "interTapMaxMs": 400,
      "activation": "complete standalone down/up pairs; same count toggles both directions",
      "ownership": "capture sessionId at key down; reject stale sessions and finalizing captures",
      "reset": "capture or preferences revision changes, shortcut reconfiguration, hook reset, combinations, repeat, long hold",
      "effectiveMode": "BackendSnapshot.dictation.translationActive",
      "customTranslationShortcut": "preserve binding and existing arm-only behavior; no additional Shift action"
    }
  },
